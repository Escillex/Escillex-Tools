{
	"id": "/",
	"name": "Escillex Tools",
	"short_name": "Tools",
	"description": "Small everyday tools. Your data stays on your own devices.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#000000",
	"theme_color": "#000000",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Wallet",
			"short_name": "Wallet",
			"url": "/wallet",
			"icons": [
				{
					"src": "/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Yellowpad",
			"short_name": "Yellowpad",
			"url": "/yellowpad",
			"icons": [
				{
					"src": "/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Fidget",
			"short_name": "Fidget",
			"url": "/fidget",
			"icons": [
				{
					"src": "/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		}
	],
	"file_handlers": [
		{
			"action": "/",
			"accept": {
				"application/x-escillex-backup": [
					".escb"
				]
			},
			"launch_type": "single-client"
		},
		{
			"action": "/yellowpad",
			"accept": {
				"text/markdown": [
					".md",
					".markdown"
				]
			},
			"launch_type": "multiple-clients"
		}
	]
}
