{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true
	},
	"include": ["src", "vite.config.ts"],
	// The service worker runs in a different environment (no DOM), so it has its own tsconfig.
	// src/worker.ts imports a build output, so it's checked by the build, not here.
	"exclude": ["src/service-worker", "src/worker.ts"]
}
