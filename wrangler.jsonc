// Cloudflare deploy settings. `npm run build` writes the app into
// .svelte-kit/cloudflare; wrangler uploads it from there.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "escillex-tools",
	// The small server script (handles anything that isn't a static file, like the sync room).
	// `npm run build` points it at src/worker.ts (see scripts/wrap-worker.js).
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	// The built app: JS, CSS, fonts, icons, and the prerendered pages.
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// The sync room: one per pairing code. Two devices meet here and swap
	// encrypted snapshots live. Nothing is stored, and it sleeps while waiting.
	"durable_objects": { "bindings": [{ "name": "SYNC_ROOM", "class_name": "SyncRoom" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],
	// Per-IP limit for opening sync connections: 60 per minute.
	"ratelimits": [{ "name": "SYNC_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
