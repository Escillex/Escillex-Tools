// Cloudflare deploy settings. `npm run build` writes the app into
// .svelte-kit/cloudflare; wrangler uploads it from there.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "escillex-tools",
	// The small server script (handles anything that isn't a static file, like the sync relay).
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	// The built app: JS, CSS, fonts, icons, and the prerendered pages.
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// The sync mailbox. Holds encrypted snapshots for 10 minutes. Local dev
	// uses a fake on-disk copy; the real one gets created on Cloudflare.
	"kv_namespaces": [{ "binding": "SYNC" }],
	// Per-IP request limit for the sync API: 60 requests per minute.
	"ratelimits": [{ "name": "SYNC_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
